# Modelo de variáveis para o docker compose. Copie e troque os valores:
#   cp .env.example .env
# O .env está no .gitignore: nunca versione senhas ou chaves.
# Para gerar valores aleatórios:
#   openssl rand -base64 48              -> JWT_KEY
#   echo "Sa1-$(openssl rand -hex 12)"   -> MSSQL_SA_PASSWORD / ADMIN_PASSWORD

# Ambiente da API: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Senha do usuário sa do SQL Server.
# Política: 8+ caracteres com maiúsculas, minúsculas, números e símbolos. Evite ; e $.
MSSQL_SA_PASSWORD=Troque-Esta-Senha-123
DB_NAME=OrbitalSOS
# Porta do SQL Server no host (só 127.0.0.1)
DB_PORT=1433

# Chave de assinatura do JWT (mínimo 32 caracteres)
JWT_KEY=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Administrador inicial (opcional): criado na primeira inicialização se ainda não existir.
# O cadastro público (/api/auth/register) sempre cria usuários comuns.
ADMIN_EMAIL=admin@orbitalsos.local
ADMIN_PASSWORD=Troque-Esta-Senha-Admin-123

# Porta da API no host
API_PORT=8080
# Versão exibida em /health (no pipeline é o SHA do commit)
APP_VERSION=local

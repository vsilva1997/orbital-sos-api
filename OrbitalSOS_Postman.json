        {
          "name": "List Shelters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/shelters?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shelters"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" },
                { "key": "lat", "value": "-23.5505", "disabled": true },
                { "key": "lon", "value": "-46.6333", "disabled": true },
                { "key": "radiusKm", "value": "10", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Shelter by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/shelters/{{shelterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "shelters", "{{shelterId}}"]
            }
          }
        },
        {
          "name": "Create Shelter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var json = pm.response.json();",
                  "  pm.collectionVariables.set('shelterId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Abrigo Central SP\",\n  \"address\": \"Rua da Consolação, 1000, São Paulo, SP\",\n  \"latitude\": -23.5505,\n  \"longitude\": -46.6333,\n  \"capacity\": 200,\n  \"type\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/shelters", "host": ["{{baseUrl}}"], "path": ["api", "shelters"] }
          }
        }
      ]
    },
